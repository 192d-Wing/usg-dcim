# Build context: REPO ROOT — otter-go depends on packages/shared-go via
# an in-tree replace directive.
#
# Multi-binary image: cmd/otter-go is the HTTP server, cmd/otter-go-
# scheduler is the cron-driven worker introduced in PR #208 (Helm
# sub-chart in PR #209 selects the entrypoint). cmd/otter-go-migrate
# replaces the Python alembic migrations Job after the final Python
# rip — embeds the goose .sql files so the runtime image needs no
# external migration directory. All binaries live in the same image
# so a Helm release pins a single image tag for everything.
# cmd/otter-go-worker (the ARIN drain) is built too; it stays dark
# from k8s until its own sub-chart lands.
# Build stage runs on the build host's native arch ($BUILDPLATFORM)
# and Go cross-compiles via GOOS/GOARCH, so multi-arch builds never
# run the compiler under qemu — only the final stage's small RUNs
# emulate. TARGETOS/TARGETARCH are empty on single-arch builds and Go
# falls back to the host defaults, so plain `podman build` behaves
# exactly as before.
FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS build
ARG TARGETOS TARGETARCH
WORKDIR /src
COPY packages/shared-go ./packages/shared-go
COPY packages/otter-go  ./packages/otter-go
WORKDIR /src/packages/otter-go
RUN go mod download
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags='-s -w' -o /out/otter-go           ./cmd/otter-go
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags='-s -w' -o /out/otter-go-scheduler ./cmd/otter-go-scheduler
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags='-s -w' -o /out/otter-go-worker    ./cmd/otter-go-worker
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags='-s -w' -o /out/otter-go-migrate   ./cmd/otter-go-migrate

# Iron Bank UBI. distroless shipped a `nonroot` user at uid/gid 65532;
# UBI does not. otter-go's chart pins runAsUser/runAsGroup/fsGroup to
# 65532 AND sets readOnlyRootFilesystem: true, so the user must exist at
# those exact ids and nothing may write outside a mounted volume.
FROM registry1.dso.mil/ironbank/redhat/ubi/ubi10:10.2
RUN groupadd -g 65532 nonroot \
 && useradd -r -u 65532 -g nonroot -s /sbin/nologin -M nonroot
COPY --from=build /out/otter-go           /otter-go
COPY --from=build /out/otter-go-scheduler /otter-go-scheduler
COPY --from=build /out/otter-go-worker    /otter-go-worker
COPY --from=build /out/otter-go-migrate   /otter-go-migrate
EXPOSE 8000
USER nonroot:nonroot
# Default entrypoint stays /otter-go so existing deployments don't
# need any changes. Sub-charts that run the scheduler/worker
# override `command:` to point at the matching binary.
ENTRYPOINT ["/otter-go"]
