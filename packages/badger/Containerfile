# Native build stage + GOOS/GOARCH cross-compile so multi-arch builds
# don't run the Go compiler under qemu; empty TARGETOS/TARGETARCH on
# single-arch builds fall back to host defaults.
FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS build
ARG TARGETOS TARGETARCH
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags='-s -w' -o /out/badger .

# Iron Bank UBI. Same reason we were on Alpine rather than distroless:
# a real filesystem, so /var/lib is writable for the SQLite buffer when
# the operator hasn't mounted a volume there yet.
#
# `adduser -D` was busybox; UBI has shadow-utils, so this is useradd.
# uid 65532 is kept — the Helm charts pin runAsUser to it.
FROM registry1.dso.mil/ironbank/redhat/ubi/ubi10:10.2
RUN groupadd -g 65532 collector \
 && useradd -r -u 65532 -g collector -s /sbin/nologin -M collector \
 && mkdir -p /var/lib/dcim-collector \
 && chown collector:collector /var/lib/dcim-collector
COPY --from=build /out/badger /badger
USER collector
ENTRYPOINT ["/badger"]
