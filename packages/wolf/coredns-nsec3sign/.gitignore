# Go build artifacts. go.sum is intentionally NOT ignored — we want
# checksums in version control once the module first builds.
/coredns
/out/
*.test
*.out
# Coverage profile produced by `go test -cover -coverprofile=…` and
# the bare `coverage` file `go test -cover` drops when a downstream
# tool errors before consuming it. Neither is useful in version
# control.
coverage
coverage.out
vendor/
