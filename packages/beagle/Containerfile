# Build context: REPO ROOT — beagle depends on packages/shared-go via
# an in-tree replace directive.
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY packages/shared-go ./packages/shared-go
COPY packages/beagle    ./packages/beagle
WORKDIR /src/packages/beagle
RUN go mod download
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/beagle .

# Use a small Alpine image (not distroless) so ICMP works without raw sockets
# via the unprivileged SOCK_DGRAM path, which still needs a real /proc.
FROM alpine:3.20
RUN adduser -D -u 65532 probe
COPY --from=build /out/beagle /beagle
EXPOSE 8102
USER probe
ENTRYPOINT ["/beagle"]
