# Build context: REPO ROOT — beagle depends on packages/shared-go via
# an in-tree replace directive.
# Native build stage + GOOS/GOARCH cross-compile so multi-arch builds
# don't run the Go compiler under qemu; empty TARGETOS/TARGETARCH on
# single-arch builds fall back to host defaults.
FROM --platform=$BUILDPLATFORM golang:1.27-alpine AS build
ARG TARGETOS TARGETARCH
WORKDIR /src
COPY packages/shared-go ./packages/shared-go
COPY packages/beagle    ./packages/beagle
WORKDIR /src/packages/beagle
RUN go mod download
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags='-s -w' -o /out/beagle .

# Iron Bank UBI. Same reason we were on Alpine rather than distroless:
# ICMP works without raw sockets via the unprivileged SOCK_DGRAM path,
# which still needs a real /proc.
#
# `adduser -D` was busybox; UBI has shadow-utils, so this is useradd.
# uid 65532 is kept — beagle's deployment pins runAsUser to it.
#
# --platform=$TARGETPLATFORM is explicit because the build stage's
# --platform=$BUILDPLATFORM otherwise leaks into this FROM on CI's
# buildah — cross-built arm64 images silently got an amd64 base.
FROM --platform=$TARGETPLATFORM registry1.dso.mil/ironbank/redhat/ubi/ubi10:10.2
RUN groupadd -g 65532 probe \
 && useradd -r -u 65532 -g probe -s /sbin/nologin -M probe
COPY --from=build /out/beagle /beagle
EXPOSE 8102
USER probe
ENTRYPOINT ["/beagle"]
