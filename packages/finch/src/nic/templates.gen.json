      "label": "Organization",
      "table": "nic_reg_organization",
      "actions": ["N", "M", "D", "R"],
      "arinEligible": false,
      "sections": [
        {
          "title": "Administrative",
          "fields": [
            { "key": "agency", "label": "Agency", "type": "string", "required": true, "maxLength": 64, "help": "Service/agency, e.g. ARMY, NAVY." },
            { "key": "primary_org_poc", "label": "Primary Org POC", "type": "string", "required": false, "maxLength": 128, "help": "Handle of primary point of contact." },
            { "key": "secondary_org_poc", "label": "Secondary Org POC", "type": "string", "required": false, "maxLength": 128, "help": "Handle of alternate point of contact." }
          ]
        },
        {
          "title": "Organization",
          "fields": [
            { "key": "organization_name", "label": "Organization Name", "type": "string", "required": true, "maxLength": 128, "help": "Name of your organization." },
            { "key": "address_line1", "label": "Address Line 1", "type": "string", "required": true, "maxLength": 128 },
            { "key": "address_line2", "label": "Address Line 2", "type": "string", "required": false, "maxLength": 128 },
            { "key": "address_line3", "label": "Address Line 3", "type": "string", "required": false, "maxLength": 128 },
            { "key": "address_line4", "label": "Address Line 4", "type": "string", "required": false, "maxLength": 128 },
            { "key": "city", "label": "City or APO/FPO", "type": "string", "required": true, "maxLength": 128, "help": "City, or APO (Army/Air Force) / FPO (Navy/Marine) post office." },
            { "key": "state_code", "label": "State or APO/FPO Code", "type": "string", "required": true, "maxLength": 16, "help": "State, or MPSA code AA/AE/AP." },
            { "key": "zip_code", "label": "Zip Code", "type": "string", "required": false, "maxLength": 16 },
            { "key": "org_mailbox", "label": "Organizational Mailbox", "type": "email", "required": false, "maxLength": 256, "help": "Organization email address." }
          ]
        },
        {
          "title": "Comments",
          "fields": [
            { "key": "user_comments", "label": "User Comments", "type": "text", "required": false, "help": "Free-form; notes to Approving Official / NIC." }
          ]
        }
      ]
    },
    "user": {
      "nicId": "NIC-USER",
      "label": "User (POC)",
      "table": "nic_reg_user",
      "actions": ["N", "M", "D", "R"],
