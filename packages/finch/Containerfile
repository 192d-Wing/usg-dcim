# Node 24 is the active LTS. Keep this in lockstep with node-version in
# .github/workflows/ci.yml — CI is what actually runs the tests, so if
# the two drift we ship an image built on a runtime nothing tested.
FROM node:24-alpine AS build
WORKDIR /app
# Copy the lockfile and use `npm ci`, not `npm install`. Without the
# lockfile npm re-resolves every range against the registry at build
# time, so the image ships a dependency tree nobody tested and the build
# breaks on upstream releases unrelated to the commit being built. `npm
# ci` installs exactly what CI installed.
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

FROM nginx:1.31-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
