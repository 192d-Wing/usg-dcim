# Build context: REPO ROOT — magpie depends on packages/shared-go via
# an in-tree replace directive.
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY packages/shared-go ./packages/shared-go
COPY packages/magpie    ./packages/magpie
WORKDIR /src/packages/magpie
RUN go mod download
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/magpie .

# Iron Bank UBI. distroless shipped a `nonroot` user at uid/gid 65532;
# UBI does not, and the Helm charts pin runAsUser/fsGroup to 65532, so
# recreate it at the same ids.
FROM registry1.dso.mil/ironbank/redhat/ubi/ubi10:10.2
RUN groupadd -g 65532 nonroot \
 && useradd -r -u 65532 -g nonroot -s /sbin/nologin -M nonroot
COPY --from=build /out/magpie /magpie
EXPOSE 8101
USER nonroot:nonroot
ENTRYPOINT ["/magpie"]
