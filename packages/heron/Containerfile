# Build context: REPO ROOT (not packages/heron/). The build needs
# packages/shared-go alongside heron because of the in-tree replace
# directive in go.mod.
# Native build stage + GOOS/GOARCH cross-compile so multi-arch builds
# don't run the Go compiler under qemu; empty TARGETOS/TARGETARCH on
# single-arch builds fall back to host defaults.
FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS build
ARG TARGETOS TARGETARCH
WORKDIR /src
COPY packages/shared-go ./packages/shared-go
COPY packages/heron     ./packages/heron
WORKDIR /src/packages/heron
RUN go mod download
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags='-s -w' -o /out/heron .

# Iron Bank UBI. distroless shipped a `nonroot` user at uid/gid 65532;
# UBI does not, and the Helm charts pin runAsUser/fsGroup to 65532
# (deploy/helm/dcim/charts/*/values.yaml), so recreate it at the same
# ids or the pod security context stops matching the image.
#
# --platform=$TARGETPLATFORM is explicit because the build stage's
# --platform=$BUILDPLATFORM otherwise leaks into this FROM on CI's
# buildah — cross-built arm64 images silently got an amd64 base.
FROM --platform=$TARGETPLATFORM registry1.dso.mil/ironbank/redhat/ubi/ubi10:10.2
RUN groupadd -g 65532 nonroot \
 && useradd -r -u 65532 -g nonroot -s /sbin/nologin -M nonroot
COPY --from=build /out/heron /heron
EXPOSE 8100
USER nonroot:nonroot
ENTRYPOINT ["/heron"]
