{
  "realm": "dcim",
  "enabled": true,
  "displayName": "USG DCIM",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "sslRequired": "none",
  "accessTokenLifespan": 600,
  "ssoSessionIdleTimeout": 1800,

  "clients": [
    {
      "clientId": "dcim-spa",
      "name": "DCIM API + SPA",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "dev-secret-change-me",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:8000/api/v1/auth/oidc/callback*"
      ],
      "webOrigins": ["http://localhost:5173", "http://localhost:8000"],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:5173/*"
      }
    }
  ],

  "roles": {
    "realm": [
      { "name": "dcim-admin",  "description": "Maps to DCIM EnterpriseAdmin via OIDC role mappings" },
      { "name": "dcim-viewer", "description": "Maps to DCIM Viewer via OIDC role mappings" }
    ]
  },

  "users": [
    {
      "username": "demo",
      "email": "demo@dcim.local",
      "firstName": "Demo",
      "lastName": "Operator",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {"type": "password", "value": "demo", "temporary": false}
      ],
      "realmRoles": ["dcim-admin"]
    }
  ]
}
