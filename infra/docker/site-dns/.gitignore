# Per-site config + secrets. Operators copy collector.yaml.example to
# collector.yaml and drop the issued bearer token alongside it; neither
# should ever land in version control.
collector.yaml
token
# Per-host overrides — currently used for DNS_RECURSIVE_BIND_IP so the
# Hickory overlay can publish 53 on the operator's LAN IP without
# baking the address into the tracked compose file.
.env
