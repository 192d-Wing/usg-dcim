# Site collector config — pointed at the central DCIM running on the
# same Docker engine. Copy this to `collector.yaml` in the same dir
# and fill in the UUIDs (collector_id, site_id, DnsServer ids) you
# created in central before bringing the bundle up.

# UUID of the Collector row central issued at enrollment.
collector_id: 00000000-0000-0000-0000-000000000000

# Site this collector reports for. Pre-create the Site row in central
# (IPAM → Sites or Site Show) and paste its UUID here.
site_id: 00000000-0000-0000-0000-000000000000

# Telemetry ingest endpoint. `host.docker.internal:8000` reaches the
# central api when both compose projects run on the same Docker engine.
# The `extra_hosts: host-gateway` mapping in docker-compose.yml is what
# makes that resolution work on Linux.
ingest_url: http://host.docker.internal:8000/ingest

# Bearer token central issued to this collector. Read from a file rather
# than embedded inline so the operator can rotate without re-templating.
api_token_file: /etc/dcim/token

heartbeat_interval_seconds: 30
buffer_path: /var/lib/dcim-collector/buffer.db

# No mTLS for the local dev path. Production deployments toggle this on
# and mount the leaf cert + CA bundle.
mtls:
  enabled: false

# No SNMP/IPMI/Redfish devices on the site bundle by default. Operators
# extend this list once they catalog real assets at this site.
devices: []

# DNS agent — polls /api/v1/dns/servers/{id}/bundle for each entry and
# writes Corefile + zone files into the matching output_dir, then
# signals the matching pids to reload.
#
# GoBGP deprecation: the prior gobgp_pidfile + gobgp_api_host fields
# are gone. Cilium BGP advertises the recursive DNS LoadBalancer
# service at the cluster level (CiliumBGPPeeringPolicy +
# CiliumLoadBalancerIPPool) — the in-pod gobgpd process no longer
# runs, so there's nothing for the agent to PID-signal.
dns:
  enabled: true
  poll_interval_seconds: 30
  # Defaults to derive from ingest_url's origin; override if the DNS
  # endpoints live behind a different host.
  api_base: http://host.docker.internal:8000
  # CoreDNS Prometheus scrape — the collector pushes interval deltas
  # to /api/v1/dns/servers/{id}/metrics for the Servers tab dashboard.
  metrics_enabled: true
  metrics_interval_seconds: 60
  # Run DnsHealthCheck probes from this collector. Useful when probe
  # targets live on site networks central can't reach (the central
  # worker falls back to its own probes when the collector goes
  # quiet, so a collector that drops offline doesn't strand status).
  # Set health_check_fabric_id to the fabric whose checks this site
  # owns — leaving it blank leaves probes to central.
  health_checks_enabled: false
  # health_check_fabric_id: 00000000-0000-0000-0000-000000000000
  health_check_poll_interval_seconds: 60
  servers:
    - id: 00000000-0000-0000-0000-000000000000   # auth DnsServer
      role: auth
      output_dir: /var/lib/dcim-dns/auth
      coredns_pidfile: /var/lib/dcim-dns/auth/coredns.pid
      # When the collector shares dns-net with the coredns pods, scrape
      # via service name. Otherwise leave the default 127.0.0.1:9153
      # (works for host-networked deployments).
      metrics_url: http://coredns-auth:9153/metrics
    - id: 00000000-0000-0000-0000-000000000000   # recursive DnsServer
      role: recursive
      output_dir: /var/lib/dcim-dns/recursive
      coredns_pidfile: /var/lib/dcim-dns/recursive/coredns.pid
      metrics_url: http://coredns-recursive:9153/metrics
